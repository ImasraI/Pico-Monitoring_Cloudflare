[Unit]
Description=DANTO Oracle backend
After=network.target

[Service]
User=danto
Group=danto
WorkingDirectory=/opt/danto
EnvironmentFile=/etc/danto.env
ExecStart=/usr/bin/node --max-old-space-size=256 /opt/danto/server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/danto
MemoryMax=512M

[Install]
WantedBy=multi-user.target
